{
  "expo": {
    "owner": "smashpro-digital-llc",
    "name": "Servicios El Paisano",
    "slug": "servicios-elpaisano",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "servicioselpaisano",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,

    "ios": {
      "bundleIdentifier": "com.servicioselpaisano.app",
      "buildNumber": "2",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Allow Servicios El Paisano to attach photos to service requests.",
        "NSPhotoLibraryUsageDescription": "Allow Servicios El Paisano to attach photos to service requests."
      }
    },

    "android": {
      "package": "com.servicioselpaisano.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },

    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },

    "plugins": [
      "expo-router",
      "expo-document-picker",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Servicios El Paisano to attach photos to service requests.",
          "photosPermission": "Allow Servicios El Paisano to attach selected photos to service requests.",
          "microphonePermission": false
        }
      ],
      "expo-notifications",
      [
        "expo-splash-screen",
  {
    "image": "./assets/images/splash-luxury.png",
    "imageWidth": 360,
    "resizeMode": "contain",
    "backgroundColor": "#0A1A30",
    "dark": {
      "image": "./assets/images/splash-luxury.png",
      "backgroundColor": "#0A1A30"
    }
        }
      ]
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "f46a8755-efe2-4c78-9fd5-12fb1301d5ef"
      }
    }
  }
}
